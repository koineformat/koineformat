{
  "name": "koineformat",
  "version": "0.1.1",
  "description": "Definitions, types, decisions and their history as ordinary files beside your documents — so knowledge can leave home and still be understood, checked, and trusted.",
  "homepage": "https://koineformat.org",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koineformat/koineformat.git"
  },
  "bugs": {
    "url": "https://github.com/koineformat/koineformat/issues"
  },
  "author": "NoeBase <dev@noebase.com>",
  "license": "Apache-2.0",
  "keywords": [
    "knowledge",
    "format",
    "provenance",
    "merkle",
    "agents",
    "llm",
    "ai",
    "interchange",
    "packages",
    "vendoring",
    "registry"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "koine": "dist/koine.js"
  }
}
